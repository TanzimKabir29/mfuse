# Port the Axum server listens on.
SERVER_PORT=9001

# Postgres connection string. Matches docker-compose.yml's postgres service by default.
DATABASE_URL=postgres://mfuse:mfuse_dev_password@localhost:9002/mfuse

# Google OAuth 2.0 credentials. Create these in Google Cloud Console under
# APIs & Services > Credentials > OAuth client ID (Web application).
# See backend/README.md for the full walkthrough.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:9001/v1/auth/google/callback

# The frontend's origin, used for CORS. Must match exactly (scheme + host + port).
FRONTEND_ORIGIN=http://localhost:9000
